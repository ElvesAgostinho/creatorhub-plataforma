# ---------------------------------------------------------------- Base de dados
# Postgres do EasyPanel. Dentro da rede do EasyPanel usa o nome do serviço como
# anfitrião (sem SSL); de fora, o endereço público com sslmode=require.
DATABASE_URL=postgres://utilizador:palavra_passe@nome_do_servico:5432/nome_da_base
PGPOOL_MAX=10

# ---------------------------------------------------------------- Sessões
# 32+ caracteres aleatórios. Gera com:  openssl rand -base64 48
# Mudá-la termina a sessão de toda a gente.
AUTH_SECRET=
# true obriga a confirmar o email antes do primeiro login
AUTH_EXIGIR_CONFIRMACAO=false

# ---------------------------------------------------------------- Ficheiros (MinIO)
S3_ENDPOINT=minio.topconsultores.pt
S3_PORT=443
S3_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Endereço por onde o browser vê os ficheiros públicos
S3_PUBLIC_URL=https://minio.topconsultores.pt
NEXT_PUBLIC_S3_URL=https://minio.topconsultores.pt
UPLOAD_LIMITE_MB=500

# ---------------------------------------------------------------- Aplicação
NEXT_PUBLIC_APP_URL=https://bizlink.topconsultores.pt
RESEND_API_KEY=
ADMIN_EMAIL=
